asset.onInitialize(function()
  for _, n in ipairs(nodes) do
    openspace.addSceneGraphNode(n)
  end
end)

asset.onDeinitialize(function()
  for i = #nodes, 1, -1 do
    openspace.removeSceneGraphNode(nodes[i].Identifier)
  end
end)

asset.export("nodes", nodes)

asset.meta = {
  Name = "Hyades ZDI Surface Maps",
  Version = "1.0",
  Description = "Zeeman-Doppler Imaging radial-field maps rendered on spheres at Gaia positions.",
  Author = "Federica Chiti",
  URL = "https://github.com/USERNAME/ZDIviz",
  License = "MIT"
}
